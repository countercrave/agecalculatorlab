# Apache / cPanel
Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^tools/age-calculator/?$ / [R=301,L]
RewriteRule ^dog-age-calculator/?$ /tools/dog-age-calculator/ [R=301,L]
  RewriteRule ^age-difference-calculator/?$ /tools/age-difference-calculator/ [R=301,L]
  RewriteRule ^corrected-age-calculator/?$ /tools/corrected-age-calculator/ [R=301,L]
  RewriteRule ^privacy-policy/?$ /privacy/ [R=301,L]
  RewriteRule ^terms-of-use/?$ /terms/ [R=301,L]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>
